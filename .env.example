# Our Home environment configuration. Never commit real secrets.
# The game runs fully offline (local cache only) without any of these.

# ---------------------------------------------------------------------------
# Single shared living room save (server-side, used by api/home-state.ts)
# ---------------------------------------------------------------------------
# There is exactly ONE shared room for the couple across every device/browser.
# api/home-state.ts picks the first configured store, in this order:
#
# 1) Upstash Redis (recommended; Vercel Marketplace → Upstash / "Vercel KV")
#    Stored as JSON under the fixed key "our-home:shared-save:v1".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#    Vercel KV injects these names instead; either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# 2) Supabase (run supabase/migrations/0002_shared_home.sql first)
#    Stored in public.shared_home, single row id = 'our-home'.
#    Prefer the service role key (server-only! never expose it with a VITE_ prefix).
#    Falls back to SUPABASE_ANON_KEY / VITE_SUPABASE_PUBLISHABLE_KEY via the RLS policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
#
# 3) Neither configured → GET returns { state: null, backend: "unconfigured" }
#    and each device keeps playing from its own local cache.

# ---------------------------------------------------------------------------
# Public client configuration (bundled into the browser build)
# ---------------------------------------------------------------------------
# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Auth0 Single Page Application (Settings → Basic)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
